	partition f_ConversaoProdutos = m
		mode: import
		queryGroup: 'Tabelas Principais'
		source = ```
				let
				  //Origem = Folder.Files("C:\Users\proxx\OneDrive\Área de Trabalho\PXX\Estoque\Conversão de Produtos"),
				  Origem = Folder.Files(#"Pasta Raiz" & "\Conversão de Produtos"),
				  #"Arquivos ocultos filtrados" = Table.SelectRows(Origem, each [Attributes]?[Hidden]? <> true),
				    #"Arquivos Ocultos Filtrados1" = Table.SelectRows(#"Arquivos ocultos filtrados", each [Attributes]?[Hidden]? <> true),
				    #"Invocar Função Personalizada1" = Table.AddColumn(#"Arquivos Ocultos Filtrados1", "Transformar Arquivo (5)", each #"Transformar Arquivo (5)"([Content])),
				    #"Colunas Renomeadas1" = Table.RenameColumns(#"Invocar Função Personalizada1", {"Name", "Nome da Origem"}),
				    #"Outras Colunas Removidas1" = Table.SelectColumns(#"Colunas Renomeadas1", {"Nome da Origem", "Transformar Arquivo (5)"}),
				    #"Coluna de Tabela Expandida1" = Table.ExpandTableColumn(#"Outras Colunas Removidas1", "Transformar Arquivo (5)", Table.ColumnNames(#"Transformar Arquivo (5)"(#"Arquivo de Amostra (5)"))),
				    #"Tipo Alterado" = Table.TransformColumnTypes(#"Coluna de Tabela Expandida1",{{"Seq. Conversão", Int64.Type}, {"Contrato", type text}, {"Projeto", type text}, {"Cód. Material Origem", type text}, {"Material Origem", type text}, {"Unid. Origem", type text}, {"Cód. Material Destino", type text}, {"Material Destino", type text}, {"Unid. Destino", type text}, {"Qtde Origem", type number}, {"Qtde Destino", type number}, {"Cod. Cpl Orig.", type text}, {"Cod. Cpl Destino", type text}, {"Usuário Criação", type text}, {"Dia Criação", type date}, {"Hora Criação", type time}}),
				    #"Colunas Removidas" = Table.RemoveColumns(#"Tipo Alterado",{"Fator", "Nome da Origem", "Valor Unit. Origem", "Valor Unit. Destino", "Total Destino", "Valor Total"}),
				    
				    // Criando a coluna de Condição Origem Convertida (Lógica 1)
				    Condição = Table.AddColumn(#"Colunas Removidas", "Condição Origem", each 
				    let 
				        // Se for null, transforma em texto vazio "" antes do Text.Upper
				        Cod = Text.Upper(Text.From([Material Origem] ?? "")) 
				    in
				        if Text.Contains(Cod, "DEF-") or Text.Contains(Cod, "DET-") then "DEFEITO"
				        else if Text.Contains(Cod, "RET-") then "RETIRADO"
				        else if Text.Contains(Cod, "REAP-") or Text.Contains(Cod, "REA-") then "REAPROVEITADO"
				        else if Text.Contains(Cod, "SUC-") then "DESUSO"
				        else if [Material Origem] <> null and [Material Origem] <> "" then "NOVO"
				        else "VAZIO"
				    ),
				
				    // Criando a coluna de Verificação de N° de Série Origem (Lógica 2)
				    NumSerie = Table.AddColumn(#"Condição", "Origem é Serializado?", each 
				        if [#"Cod. Cpl Orig."] = null or [#"Cod. Cpl Orig."] = "" then "VAZIO"
				        else if [#"Cod. Cpl Orig."] = "-" then "NÃO" 
				        else "SIM"
				    ),
				
				    // Criando a coluna de Condição Destino Convertida (Lógica 3)
				    Condição2 = Table.AddColumn(#"NumSerie", "Condição Destino", each 
				    let 
				        // Se for null, transforma em texto vazio "" antes do Text.Upper
				        Cod = Text.Upper(Text.From([Material Destino] ?? "")) 
				    in
				        if Text.Contains(Cod, "DEF-") or Text.Contains(Cod, "DET-") then "DEFEITO"
				        else if Text.Contains(Cod, "RET-") then "RETIRADO"
				        else if Text.Contains(Cod, "REAP-") or Text.Contains(Cod, "REA-") then "REAPROVEITADO"
				        else if Text.Contains(Cod, "SUC-") then "DESUSO"
				        else if [Material Destino] <> null and [Material Destino] <> "" then "NOVO"
				        else "VAZIO"
				    ),
				
				    // Criando a coluna de Verificação de N° de Série Destino (Lógica 24)
				    NumSerie2 = Table.AddColumn(#"Condição2", "Destino é Serializado?", each 
				        if [#"Cod. Cpl Destino"] = null or [#"Cod. Cpl Destino"] = "" then "VAZIO" 
				        else if [#"Cod. Cpl Destino"] = "-" then "NÃO"
				        else "SIM"
				    ),
				    #"Valor Substituído" = Table.ReplaceValue(NumSerie2,null,0,Replacer.ReplaceValue,{"Qtde Origem"}),
				    #"Valor Substituído1" = Table.ReplaceValue(#"Valor Substituído",null,0,Replacer.ReplaceValue,{"Qtde Destino"}),
				    #"Tipo Alterado1" = Table.TransformColumnTypes(#"Valor Substituído1",{{"Condição Origem", type text}, {"Origem é Serializado?", type text}, {"Condição Destino", type text}, {"Destino é Serializado?", type text}}),
				    #"Consultas Mescladas" = Table.NestedJoin(#"Tipo Alterado1", {"Material Origem"}, #"d_DE-PARA-TECNOLOGIA", {"EQUIPAMENTO"}, "d_DE-PARA-TECNOLOGIA", JoinKind.LeftOuter),
				    #"d_DE-PARA-TECNOLOGIA Expandido" = Table.ExpandTableColumn(#"Consultas Mescladas", "d_DE-PARA-TECNOLOGIA", {"CATEGORIA"}, {"d_DE-PARA-TECNOLOGIA.CATEGORIA"}),
				    #"Colunas Renomeadas" = Table.RenameColumns(#"d_DE-PARA-TECNOLOGIA Expandido",{{"d_DE-PARA-TECNOLOGIA.CATEGORIA", "Categoria da Origem"}}),
				    #"Consultas Mescladas1" = Table.NestedJoin(#"Colunas Renomeadas", {"Material Destino"}, #"d_DE-PARA-TECNOLOGIA", {"EQUIPAMENTO"}, "d_DE-PARA-TECNOLOGIA", JoinKind.LeftOuter),
				    #"d_DE-PARA-TECNOLOGIA Expandido1" = Table.ExpandTableColumn(#"Consultas Mescladas1", "d_DE-PARA-TECNOLOGIA", {"CATEGORIA"}, {"d_DE-PARA-TECNOLOGIA.CATEGORIA"}),
				    #"Colunas Renomeadas2" = Table.RenameColumns(#"d_DE-PARA-TECNOLOGIA Expandido1",{{"d_DE-PARA-TECNOLOGIA.CATEGORIA", "Categoria do Destino"}}),
				    #"Valor Substituído2" = Table.ReplaceValue(#"Colunas Renomeadas2",null,"NÃO MAPEADO",Replacer.ReplaceValue,{"Categoria da Origem"}),
				    #"Valor Substituído3" = Table.ReplaceValue(#"Valor Substituído2",null,"NÃO MAPEADO",Replacer.ReplaceValue,{"Categoria do Destino"})
				in
				    #"Valor Substituído3"
				```

	annotation PBI_NavigationStepName = Navegação

	annotation PBI_ResultType = Table

