table f_ConversaoProdutos
	lineageTag: 12d1484c-19b8-4176-b94a-90cbb9f71d71

	measure '% Reaproveitamento' = ```
			
			VAR _TotalReaproveitado = 
			    CALCULATE(
			        COUNTROWS(f_ConversaoProdutos),
			        f_ConversaoProdutos[Condição Destino] = "REAPROVEITADO"
			    )
			
			VAR _TotalFiltrado = 
			    CALCULATE(
			        COUNTROWS(f_ConversaoProdutos),
			        ALLSELECTED(f_ConversaoProdutos[Condição Destino])
			    )
			
			RETURN
			    DIVIDE(_TotalReaproveitado, _TotalFiltrado, 0)
			
			```
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 6ee63080-953b-433c-b535-4217e06ae987

