table _Updated
	lineageTag: 720497c8-c50c-4371-a6e5-2e5c99f3d150

	measure Atualização = "Atualização dos Dados: "& MAX(_Updated[DataHoraAtualização])
		lineageTag: 8b707c35-d73f-4d91-9a97-1213c020a529

	measure Report = "RELATÓRIO DE ESTOQUE | "& FORMAT(MAX(_Updated[DataHoraAtualização]), "dd/mm/yyyy")
		lineageTag: 8320f28e-2083-4870-a29d-2bef0bcf91a5

	column DataHoraAtualização
		dataType: dateTime
		formatString: General Date
		lineageTag: 4b84677c-0a98-4679-ae11-3da31a5d76e3
		summarizeBy: none
		sourceColumn: DataHoraAtualização

		variation Variation
			isDefault
			relationship: fece9d76-2fee-4bae-acc8-a689125bfe63
			defaultHierarchy: LocalDateTable_f3027e81-cc0e-454e-9835-5efc34915420.'Hierarquia de datas'

		annotation SummarizationSetBy = Automatic

	partition _Updated = m
		mode: import
		source =
				let
				    Fonte = #table(
				        type table [DataHoraAtualização = datetime],
				        {{ DateTime.LocalNow() }}
				    )
				in
				    Fonte

	annotation PBI_NavigationStepName = Navegação

	annotation PBI_ResultType = Table

