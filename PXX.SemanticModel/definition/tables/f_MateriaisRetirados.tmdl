	column 'Status Conversao' = ```
			
			VAR vMomentoConversao = 'f_MateriaisRetirados'[Data Conv. Posterior a Retirada]
			VAR vStatusMovimento = 'f_MateriaisRetirados'[Status Movimento]
			
			RETURN
