	column 'Conv. Condição Destino' = ```
			
			VAR Cod = LOWER(f_MateriaisRetirados[Conv. Material Destino])
			RETURN
			
			SWITCH ( TRUE(),
			        -- Se a Descrição contém "DET-" ou "DEF-"
			        CONTAINSSTRING(Cod, "DEF-") || CONTAINSSTRING(Cod, "DET-"), "DEFEITO",
			        
			        -- Se a Descrição contém "RET-"
			        CONTAINSSTRING(Cod, "RET-"), "RETIRADO",
			        
			        -- Se a Descrição contém "REAP-"
			        CONTAINSSTRING(Cod, "REAP-") || CONTAINSSTRING(Cod, "REA-"), "REAPROVEITADO",
			        
			        -- Se a Descrição contém "suc-"
			        CONTAINSSTRING(Cod, "SUC-"), "DESUSO",
			        
			        -- Caso não contenha nenhum dos prefixos acima
			        IF(Cod <> BLANK() && cod <> "-", "NOVO",
			        BLANK())
			    )
			```
