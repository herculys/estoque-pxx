	measure _%_Devolvido =
			
			
			VAR retiradosTotal = SUM(f_MateriaisRetirados[Qtde. Remov.])
			VAR pendenteDEV = retiradosTotal - [_Qtd_Retirado_Devolvido]
			VAR pendenteDEVPER = DIVIDE(pendenteDEV, retiradosTotal, 0)
			RETURN
			
			DIVIDE(f_MateriaisRetirados[_Qtd_Retirado_Devolvido], retiradosTotal, 0)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: acee5e85-f6e8-4036-a018-03dadc36d1b0

	measure _%_Convertido =
			
			VAR pendenteCONV = [_Qtd_Retirado_Devolvido] - [_Qtd_Retirado_Convertido]
			VAR pendenteCONVPER = DIVIDE(pendenteCONV, [_Qtd_Retirado_Devolvido], 0)
			RETURN
			
			DIVIDE([_Qtd_Retirado_Convertido], [_Qtd_Retirado_Devolvido], 0)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: e261b5d6-83fb-4e6a-91ef-2d9eff3ae4c0

	measure '_% do total serv. Retirados' = ```
			
			
			VAR totalmes = CALCULATE(
			    SUM(f_MateriaisRetirados[Qtde. Remov.]), 
			    KEEPFILTERS('d_Calendário'),
			    REMOVEFILTERS(f_MateriaisRetirados[d_DE-PARA-TECNOLOGIA.CATEGORIA]),
			    REMOVEFILTERS(f_MateriaisRetirados[d_DE-PARA-SERVIÇO.CATEGORIA])
			)
			RETURN
			
			DIVIDE(SUM(f_MateriaisRetirados[Qtde. Remov.]), totalmes, 0)
			```
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: a8cdc146-8174-4f2d-9259-18bcff5d744e

	measure '_Diferença MoM % Retirados' = ```
			
			VAR MesAtual = SUM(f_MateriaisRetirados[Qtde. Remov.])
			VAR MesAnterior = CALCULATE(
			    SUM(f_MateriaisRetirados[Qtde. Remov.]), 
			    DATEADD('d_Calendário'[Data], -1, MONTH)
			)
			VAR CalcDiffMes = DIVIDE( MesAtual - MesAnterior, MesAnterior, 0 )
			RETURN
			CalcDiffMes
			```
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 1e7acb25-9d9e-442e-8e67-cd7b9a798090

