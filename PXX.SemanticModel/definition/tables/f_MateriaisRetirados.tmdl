	column 'Conv. Material Destino' = ```
			
			
			VAR vNumeroSerie = 'f_MateriaisRetirados'[N° Serie]
			VAR vMomentoConversao = 'f_MateriaisRetirados'[Data Conv. Posterior a Retirada]
			
			RETURN
			IF(
			    ISBLANK(vMomentoConversao),
			    BLANK(),
			    CALCULATE(
			        MIN('f_ConferenciaMovimento'[Descrição Material]),
			        
			        'f_ConferenciaMovimento'[Cod.Compl.] = vNumeroSerie,
			        ('f_ConferenciaMovimento'[DataHora Baixa]) = vMomentoConversao,
			        'f_ConferenciaMovimento'[Tipo Movimento] = "CM",
			        'f_ConferenciaMovimento'[Entrada] = 1
			    )
			)
