	column 'Nro Documento' = ```
			
			VAR vNumeroSerie = 'f_MateriaisRetirados'[N° Serie]
			VAR vDateTimeRetirada = 'f_MateriaisRetirados'[DataHora Retirada]
			
			RETURN
			// 1. Saída Rápida: Ignora não serializados e poupa processamento
			IF (
			    ISBLANK(vNumeroSerie) || vNumeroSerie = "-",
			    BLANK(),
			    
			    // 2. Lógica 1 (Conferência): Busca a data em uma tabela virtual reduzida
			    VAR vConferenciaDateTime = 
			        MINX (
			            FILTER (
			                ALL ( 
			                    'f_ConferenciaMovimento'[Cod.Compl.], 
			                    'f_ConferenciaMovimento'[DataHora Baixa] 
			                ),
			                'f_ConferenciaMovimento'[Cod.Compl.] = vNumeroSerie &&
			                'f_ConferenciaMovimento'[DataHora Baixa] >= vDateTimeRetirada
			            ),
			            'f_ConferenciaMovimento'[DataHora Baixa]
			        )
			
			    RETURN
			    IF (
			        NOT ISBLANK(vConferenciaDateTime),
			        
			        // Se encontrou Conferência, busca o Nº Doc iterando apenas o ALL necessário (Sem CALCULATE)
			        MINX (
			            FILTER (
			                ALL ( 
			                    'f_ConferenciaMovimento'[Cod.Compl.], 
			                    'f_ConferenciaMovimento'[DataHora Baixa], 
			                    'f_ConferenciaMovimento'[Nº. Doc] 
			                ),
			                'f_ConferenciaMovimento'[Cod.Compl.] = vNumeroSerie &&
			                'f_ConferenciaMovimento'[DataHora Baixa] = vConferenciaDateTime
			            ),
			            'f_ConferenciaMovimento'[Nº. Doc]
			        ),
			            
			        // 3. Lógica 2 (Aplicação): Avaliada APENAS se a Conferência falhar
			        VAR vAplicacaoDateTime = 
			            MINX (
			                FILTER (
			                    ALL ( 
			                        'f_MateriaisAplicados'[N° Serie], 
			                        'f_MateriaisAplicados'[DataHora Aplicacao] 
			                    ),
			                    'f_MateriaisAplicados'[N° Serie] = vNumeroSerie &&
			                    'f_MateriaisAplicados'[DataHora Aplicacao] >= vDateTimeRetirada
			                ),
			                'f_MateriaisAplicados'[DataHora Aplicacao]
			            )
			            
			        RETURN
			            IF (
			                NOT ISBLANK(vAplicacaoDateTime),
			                
			                // Se encontrou Aplicação, busca a OS iterando apenas o ALL necessário (Sem CALCULATE)
			                MINX (
			                    FILTER (
			                        ALL ( 
			                            'f_MateriaisAplicados'[N° Serie], 
			                            'f_MateriaisAplicados'[DataHora Aplicacao], 
			                            'f_MateriaisAplicados'[OS] 
			                        ),
			                        'f_MateriaisAplicados'[N° Serie] = vNumeroSerie &&
			                        'f_MateriaisAplicados'[DataHora Aplicacao] = vAplicacaoDateTime
			                    ),
			                    'f_MateriaisAplicados'[OS]
			                ),
			                
			                BLANK() // Se não encontrou em nenhum dos dois, retorna BLANK
			            )
			    )
			)
			```
		lineageTag: a8c70a58-9e0f-4e65-b71d-21a6103b291b
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Data Conv. Posterior a Retirada' = ```
			
			
			VAR vNumeroSerie = 'f_MateriaisRetirados'[N° Serie]
			VAR vDateTimeRetirada = 'f_MateriaisRetirados'[DataHora Retirada]
			
			VAR vConversaoDateTime = 
			    MINX(
			        FILTER (
			            'f_ConferenciaMovimento',
			            
			            'f_ConferenciaMovimento'[Cod.Compl.] = vNumeroSerie &&
			            ('f_ConferenciaMovimento'[DataHora Baixa]) >= vDateTimeRetirada &&
			            
			            'f_ConferenciaMovimento'[Tipo Movimento] = "CM" &&
			            'f_ConferenciaMovimento'[Entrada] = 1
			        ),
			        'f_ConferenciaMovimento'[DataHora Baixa]
			    )
			    
			RETURN
			    vConversaoDateTime
