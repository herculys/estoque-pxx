			        // 1. Se tiver data de conversão, está CONVERTIDO
			        NOT ISBLANK(vMomentoConversao),
			        "CONVERTIDO",
			        
			        // 2. Se NÃO tiver data, só é PENDENTE se o status for Devolução
			        IF(
			            vStatusMovimento = "Devolução de Material",
			            "PENDENTE CONVERSÃO",
			            BLANK() // Se for outro status (ex: Inventário, Estoque), fica em branco
			        )
