	column 'Status Movimento' = ```
			
			VAR vNumeroSerie = 'f_MateriaisRetirados'[N° Serie]
			VAR vDateTimeRetirada = 'f_MateriaisRetirados'[DataHora Retirada]
			
			RETURN
			// 1. Saída Rápida: Ignora imediatamente os não serializados
			IF (
			    ISBLANK(vNumeroSerie) || vNumeroSerie = "-",
			    "Não Serializado",
			    
			    // 2. Lógica 1 (Conferência): Iterando apenas as colunas necessárias com ALL
			    VAR vConferenciaDateTime = 
			        MINX (
			            FILTER (
			                ALL ( 
			                    'f_ConferenciaMovimento'[Cod.Compl.], 
			                    'f_ConferenciaMovimento'[DataHora Baixa] 
			                ),
			                'f_ConferenciaMovimento'[Cod.Compl.] = vNumeroSerie &&
			                'f_ConferenciaMovimento'[DataHora Baixa] >= vDateTimeRetirada
			            ),
			            'f_ConferenciaMovimento'[DataHora Baixa]
			        )
			
			    RETURN
			    IF (
			        NOT ISBLANK(vConferenciaDateTime),
			        
			        // Se achou, busca o tipo de movimento (novamente iterando tabela virtual pequena)
			        VAR vTipoMovimento = 
			            MINX (
			                FILTER (
			                    ALL ( 
			                        'f_ConferenciaMovimento'[Cod.Compl.], 
			                        'f_ConferenciaMovimento'[DataHora Baixa], 
			                        'f_ConferenciaMovimento'[Tipo Movimento] 
			                    ),
			                    'f_ConferenciaMovimento'[Cod.Compl.] = vNumeroSerie &&
			                    'f_ConferenciaMovimento'[DataHora Baixa] = vConferenciaDateTime
			                ),
			                'f_ConferenciaMovimento'[Tipo Movimento]
			            )
			            
			        RETURN
			            SWITCH (
			                vTipoMovimento,
			                "DM", "Devolução de Material",
			                "CM", "Conversão de Material",
			                "IE", "Inventário de Equipe",
			                "IF", "Inventário Físico",
			                "NF", "Nota Fiscal",
			                "RM", "Requisição de Material",
			                "TM", "Transferência de Material",
			                BLANK(), "Transferência entre Equipes",
			                "NÃO MAPEADO (" & vTipoMovimento & ")"
			            ),
			            
			        // 3. Lógica 2 (Aplicação): Avaliada apenas se a Lógica 1 for nula
			        VAR vAplicacaoDateTime = 
			            MINX (
			                FILTER (
			                    ALL ( 
			                        'f_MateriaisAplicados'[N° Serie], 
			                        'f_MateriaisAplicados'[DataHora Aplicacao] 
			                    ),
			                    'f_MateriaisAplicados'[N° Serie] = vNumeroSerie &&
			                    'f_MateriaisAplicados'[DataHora Aplicacao] >= vDateTimeRetirada
			                ),
			                'f_MateriaisAplicados'[DataHora Aplicacao]
			            )
			            
			        RETURN
			            IF (
			                NOT ISBLANK(vAplicacaoDateTime),
			                "Reaplicado",
			                "PENDENTE DEVOLUÇÃO"
			            )
			    )
			)
			```
		lineageTag: 6f3f9f5c-027b-41ec-9143-c8a6a3d510d7
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Data Movimento Posterior a Retirada' = ```
			
			VAR vNumeroSerie = 'f_MateriaisRetirados'[N° Serie]
			VAR vDateTimeRetirada = 'f_MateriaisRetirados'[DataHora Retirada]
			
			RETURN
			// 1. Saída Rápida: Se não houver número de série, nem perde tempo calculando
			IF (
			    ISBLANK(vNumeroSerie) || vNumeroSerie = "-",
			    BLANK(),
			    
			    // 2. Lógica 1 (Conferência): Iterando apenas as colunas necessárias com ALL
			    VAR vConferenciaDateTime = 
			        MINX (
			            FILTER (
			                ALL ( 
			                    'f_ConferenciaMovimento'[Cod.Compl.], 
			                    'f_ConferenciaMovimento'[DataHora Baixa] 
			                ),
			                'f_ConferenciaMovimento'[Cod.Compl.] = vNumeroSerie &&
			                'f_ConferenciaMovimento'[DataHora Baixa] >= vDateTimeRetirada
			            ),
			            'f_ConferenciaMovimento'[DataHora Baixa]
			        )
			        
			    RETURN
			    IF (
			        NOT ISBLANK(vConferenciaDateTime),
			        vConferenciaDateTime, // Se achou Conferência, retorna a data e encerra
			        
			        // 3. Lógica 2 (Aplicação): Avaliada APENAS se a Conferência for nula
			        VAR vAplicacaoDateTime = 
			            MINX (
			                FILTER (
			                    ALL ( 
			                        'f_MateriaisAplicados'[N° Serie], 
			                        'f_MateriaisAplicados'[DataHora Aplicacao] 
			                    ),
			                    'f_MateriaisAplicados'[N° Serie] = vNumeroSerie &&
			                    'f_MateriaisAplicados'[DataHora Aplicacao] >= vDateTimeRetirada
			                ),
			                'f_MateriaisAplicados'[DataHora Aplicacao]
			            )
			            
			        RETURN
			            vAplicacaoDateTime
			    )
			)
			```
		formatString: General Date
		lineageTag: 80928ee1-2d3d-4262-8ded-67e8ae5d01e1
		summarizeBy: none

		variation Variation
