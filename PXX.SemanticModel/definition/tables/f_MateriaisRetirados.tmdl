				    #"Consultas Mescladas1" = Table.NestedJoin(#"Colunas Reordenadas", {"Material"}, #"d_DE-PARA-TECNOLOGIA", {"EQUIPAMENTO"}, "d_DE-PARA-TECNOLOGIA", JoinKind.LeftOuter),
