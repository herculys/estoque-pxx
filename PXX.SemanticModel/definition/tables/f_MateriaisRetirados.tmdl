			    YEAR(f_MateriaisRetirados[Data Movimento Posterior a Retirada]),
			    MONTH(f_MateriaisRetirados[Data Movimento Posterior a Retirada]),
			    DAY(f_MateriaisRetirados[Data Movimento Posterior a Retirada])
			)
